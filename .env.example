EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id

# Native builds use the registered iOS bundle ID / Android package name.
EXPO_PUBLIC_APPWRITE_PLATFORM=app.luma.cycle

# Optional. If omitted, web uses the current origin and native uses luma://auth/callback.
EXPO_PUBLIC_APPWRITE_AUTH_REDIRECT_URL=

# Optional Web Push for the iOS/Android home-screen PWA. The cron reads only
# this collection — never the lumaState health blob.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_PUSH_COLLECTION_ID=
# Server-only (Vercel / Appwrite function): VAPID_PRIVATE_KEY, APPWRITE_API_KEY, CRON_SECRET

